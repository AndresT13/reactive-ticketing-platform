# Copy to .env (never commit .env).
# HS256 secret used to sign/validate JWTs locally. At least 32 characters.
TICKETING_SECURITY_LOCAL_JWT_SECRET=change-me-to-a-random-value-of-32-chars-or-more

# SQS provider: "localstack" (default) or "elasticmq". With elasticmq also set SQS_HOST=http://elasticmq:9324
COMPOSE_PROFILES=localstack
# SQS_HOST=http://elasticmq:9324
