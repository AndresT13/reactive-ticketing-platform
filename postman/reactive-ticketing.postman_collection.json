{
  "info": {
    "name": "Reactive Ticketing Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "End-to-end flow of the ticketing API. Set jwtSecret to the value of TICKETING_SECURITY_LOCAL_JWT_SECRET in .env. Requests run in order (Collection Runner)."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Optional per-request headers X-Scopes / X-Subject override the token scopes and subject; they are removed before sending.",
          "// Signs an HS256 JWT locally using the jwtSecret variable (same value as TICKETING_SECURITY_LOCAL_JWT_SECRET).",
          "const scopes = pm.request.headers.has('X-Scopes') ? pm.request.headers.get('X-Scopes') : pm.variables.get('defaultScopes');",
          "pm.request.headers.remove('X-Scopes');",
          "const subject = pm.request.headers.has('X-Subject') ? pm.request.headers.get('X-Subject') : pm.variables.get('customerId');",
          "pm.request.headers.remove('X-Subject');",
          "const secret = pm.variables.get('jwtSecret');",
          "const b64url = (wa) => CryptoJS.enc.Base64.stringify(wa).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "const now = Math.floor(Date.now() / 1000);",
          "const header = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
          "const payload = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ sub: subject, scope: scopes, iat: now, exp: now + 3600 })));",
          "const signature = b64url(CryptoJS.HmacSHA256(header + '.' + payload, secret));",
          "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + header + '.' + payload + '.' + signature });",
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: pm.variables.replaceIn('{{$guid}}') });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwtSecret",
      "value": "change-me-to-a-random-value-of-32-chars-or-more"
    },
    {
      "key": "customerId",
      "value": "customer-1"
    },
    {
      "key": "defaultScopes",
      "value": "ticketing:purchase"
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "fixedIdempotencyKey",
      "value": "postman-replay-key-0001"
    },
    {
      "key": "pollAttempts",
      "value": "0"
    }
  ],
