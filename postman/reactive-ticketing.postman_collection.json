              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const attempts = Number(pm.collectionVariables.get('pollAttempts') || 0);",
                  "if (pm.response.json().status === 'PENDING' && attempts < 20) {",
                  "  pm.collectionVariables.set('pollAttempts', attempts + 1);",
                  "  setTimeout(() => postman.setNextRequest(pm.info.requestName), 500);",
                  "} else {",
                  "  pm.collectionVariables.set('pollAttempts', 0);",
                  "  pm.test('reserved', () => pm.expect(pm.response.json().status).to.eql('RESERVED'));",
                  "}"
                ]
              }
